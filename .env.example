
# --- Django ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
# Production only (comma-separated):
# ALLOWED_HOSTS=your-app.onrender.com

# --- Database ---
# Local quick start (SQLite). For production use your Postgres URL.
DATABASE_URL=sqlite:///db.sqlite3

# --- Email ---
# Sender address. In production it must be verified with your email provider.
EMAIL_HOST_USER=you@example.com
# console = print emails (and OTP codes) in the terminal. Other values: smtp, brevo
EMAIL_PROVIDER=console
# Only needed when EMAIL_PROVIDER=brevo
# BREVO_API_KEY=your-brevo-api-key

# --- Google sign-in ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# --- Razorpay (use TEST keys only) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-test-secret

# --- Media storage (optional locally; on by default when DEBUG=False) ---
# USE_CLOUDINARY=False
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- Optional ---
# SENTRY_DSN=
# LOG_LEVEL=INFO
# TRUSTED_PROXY_COUNT=0